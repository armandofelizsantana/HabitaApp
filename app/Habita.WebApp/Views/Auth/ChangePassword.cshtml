@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="habita-page mx-auto max-w-4xl space-y-7">
    <header class="border-b border-default pb-5"><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Seguridad de la cuenta</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Cambiar contraseña</h1><p class="mt-2 max-w-2xl text-sm leading-6 text-muted">Actualiza tus credenciales para proteger el acceso a Habita.</p></header>

    <section class="rounded-3xl bg-brand-700 p-5 text-white dark:bg-[#10594f] sm:p-6" aria-labelledby="password-guidance-title">
        <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-black uppercase tracking-wider text-white/75">Antes de guardar</p><h2 id="password-guidance-title" class="mt-1 text-xl font-black">Una clave segura empieza contigo.</h2></div><p class="max-w-lg text-sm leading-6 text-white/85">Usa una contraseña única que no compartas con otros servicios y que puedas recordar.</p></div>
        <ol class="mt-5 grid gap-3 sm:grid-cols-3">
            <li class="flex items-start gap-3 rounded-2xl border border-white/15 bg-white/10 p-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 text-xs font-black">1</span><span class="pt-1 text-sm font-semibold">Verifica tu contraseña actual.</span></li>
            <li class="flex items-start gap-3 rounded-2xl border border-white/15 bg-white/10 p-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 text-xs font-black">2</span><span class="pt-1 text-sm font-semibold">Escribe una contraseña nueva de al menos ocho caracteres.</span></li>
            <li class="flex items-start gap-3 rounded-2xl border border-white/15 bg-white/10 p-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 text-xs font-black">3</span><span class="pt-1 text-sm font-semibold">Confírmala para evitar errores de escritura.</span></li>
        </ol>
    </section>

    <form asp-action="ChangePassword" method="post" class="rounded-3xl border border-default bg-(--color-bg-elevated) p-5 shadow-sm sm:p-8" data-auth-form>
        @Html.AntiForgeryToken()
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b border-default pb-4"><div><p class="text-xs font-black uppercase tracking-wider text-brand-600">Credenciales</p><h2 class="mt-1 text-xl font-black text-default">Ingresa tu nueva clave</h2></div><span class="text-xs font-semibold text-muted">Todos los campos son requeridos.</span></div>
        <div asp-validation-summary="All" class="mb-5 validation-summary" role="alert"></div>
        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1.5 sm:col-span-2"><label asp-for="CurrentPassword" class="label-base"></label><input asp-for="CurrentPassword" class="input-base" autocomplete="current-password" autofocus /><span asp-validation-for="CurrentPassword" class="field-validation"></span></div>
            <div class="space-y-1.5"><label asp-for="NewPassword" class="label-base"></label><input asp-for="NewPassword" class="input-base" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="field-validation"></span></div>
            <div class="space-y-1.5"><label asp-for="ConfirmPassword" class="label-base"></label><input asp-for="ConfirmPassword" class="input-base" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div>
        </div>
        <div class="mt-7 flex flex-col-reverse gap-3 border-t border-default pt-5 sm:flex-row sm:justify-end"><a asp-controller="Home" asp-action="Index" class="btn-secondary">Cancelar</a><button type="submit" class="btn-primary">Guardar contraseña</button></div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
