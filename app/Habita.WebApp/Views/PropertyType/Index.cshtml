@model PropertyTypeListViewModel
@{
    ViewData["Title"] = "Tipos de propiedad";
    var routeValues = new Dictionary<string, object?>();
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) routeValues["searchTerm"] = Model.SearchTerm;
}

<div class="space-y-7">
    <header class="flex flex-wrap items-end justify-between gap-5 border-b border-default pb-6">
        <div><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Catálogo / estructura</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Tipos de propiedad</h1><p class="mt-2 text-sm text-muted">Clasifica los espacios que se publican en Habita.</p></div>
        <div class="flex items-center gap-3"><span class="rounded-full bg-brand-50 px-3 py-2 text-sm font-bold text-brand-700 dark:bg-brand-100/10 dark:text-brand-400">@Model.Items.TotalCount tipos</span><a asp-action="Create" class="btn-primary">Crear tipo</a></div>
    </header>
    <div class="grid gap-7 xl:grid-cols-3">
        <section class="xl:col-span-2" aria-label="Tipos registrados">
            @if (Model.Items.Items.Count == 0)
            {
                <div class="rounded-3xl border border-dashed border-default bg-(--color-bg-elevated) p-6"><partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("tags", "Aún no hay tipos", "Registra un tipo para clasificar las propiedades.", "<a href=\"/PropertyType/Create\" class=\"btn-primary\">Crear tipo</a>")' /></div>
            }
            else
            {
                <div class="grid gap-4 md:grid-cols-2">
                    @foreach (var item in Model.Items.Items)
                    {
                        <article class="relative overflow-hidden rounded-2xl border border-default bg-(--color-bg-elevated) p-5 shadow-sm">
                            <div class="absolute right-0 top-0 h-20 w-20 rounded-bl-[3rem] bg-brand-50 dark:bg-brand-100/10"></div>
                            <div class="relative flex h-full flex-col">
                                <div class="flex items-start justify-between gap-3"><span class="rounded-lg bg-brand-50 px-3 py-1 text-xs font-black uppercase tracking-wide text-brand-700 dark:bg-brand-100/10 dark:text-brand-400">Clasificación</span><span class="text-xs font-bold text-muted">ID @item.Id</span></div>
                                <h2 class="mt-5 text-xl font-black text-default">@item.Name</h2>
                                <p class="mt-2 min-h-12 text-sm leading-6 text-muted">@item.Description</p>
                                <div class="mt-5 flex items-end justify-between border-t border-default pt-4">
                                    <div><p class="text-2xl font-black text-default">@item.PropertiesCount</p><p class="text-xs font-semibold text-muted">propiedades asociadas</p></div>
                                    <div class="flex gap-2"><a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary px-3 py-2 text-sm">Editar</a><form asp-action="Delete" method="post" data-confirm="¿Eliminar &quot;@item.Name&quot;?" data-confirm-text="Esta acción no se puede deshacer.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="page" value="@Model.Items.Page" />@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<input type="hidden" name="searchTerm" value="@Model.SearchTerm" />}<button type="submit" class="btn-ghost px-3 py-2 text-sm text-danger-600">Eliminar</button></form></div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(PropertyTypeController.Index), Controller = "PropertyType", CurrentPage = Model.Items.Page, TotalPages = Model.Items.TotalPages, RouteValues = routeValues }' />
            }
        </section>
        <aside class="h-fit rounded-2xl bg-brand-950 p-5 text-white">
            <p class="text-xs font-black uppercase tracking-[.15em] text-brand-200">Localizar</p><h2 class="mt-2 text-lg font-black">Busca en el catálogo</h2><p class="mt-2 text-sm leading-5 text-white/70">Filtra por nombre o descripción para encontrar una clasificación.</p>
            <form method="get" asp-action="Index" class="mt-5 space-y-3"><label for="type-search" class="sr-only">Buscar tipo de propiedad</label><input id="type-search" type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Ej. apartamento" class="input-base w-full text-default" /><button type="submit" class="btn-primary w-full">Buscar tipos</button>@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Index" class="block py-1 text-center text-sm font-bold text-white/80">Quitar búsqueda</a>}</form>
            <div class="mt-7 border-t border-white/15 pt-5"><p class="text-xs font-bold uppercase tracking-wider text-white/60">Total en catálogo</p><p class="mt-1 text-3xl font-black">@Model.Items.TotalCount</p></div>
        </aside>
    </div>
</div>
