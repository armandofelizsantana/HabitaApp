@model PropertyMaintenanceViewModel
@{
    ViewData["Title"] = "Mis propiedades";
}

<div class="habita-page space-y-7">
    <header class="flex flex-col gap-5 border-b border-default pb-6 md:flex-row md:items-end md:justify-between">
        <div><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Inventario del agente</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Mis propiedades</h1><p class="mt-2 max-w-xl text-sm leading-6 text-muted">Consulta publicaciones, atiende ofertas y mantén los datos de cada inmueble actualizados.</p></div>
        <div class="flex items-center gap-3"><span class="rounded-xl bg-brand-50 px-4 py-3 text-sm font-black text-brand-700 dark:bg-brand-100/10 dark:text-brand-400">@Model.Properties.TotalCount activas</span><a asp-action="Create" class="btn-primary">Crear propiedad</a></div>
    </header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700" role="alert"></div>
    }

    @if (Model.Properties.Items.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-default bg-(--color-bg-elevated) p-6">
            <partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("building-2", "Aún no tienes propiedades disponibles", "Publica tu primer inmueble para comenzar a construir tu inventario inmobiliario.", "<a href=\"/Property/Create\" class=\"btn-primary\">Crear propiedad</a>")' />
        </div>
    }
    else
    {
        <section class="overflow-hidden rounded-3xl border border-default bg-(--color-bg-elevated)" aria-label="Listado de propiedades disponibles">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-default px-5 py-4"><div><h2 class="font-black text-default">Publicaciones activas</h2><p class="mt-1 text-sm text-muted">Selecciona una operación para cada inmueble.</p></div>@if (Model.Properties.TotalPages > 1) { <span class="badge-info">Página @Model.Properties.Page de @Model.Properties.TotalPages</span> }</div>
            <div class="divide-y divide-default" role="list">
                @foreach (var property in Model.Properties.Items)
                {
                    <article class="grid gap-4 p-4 sm:grid-cols-[6rem_minmax(0,1fr)_auto] sm:items-center sm:p-5" role="listitem">
                        <a asp-action="Edit" asp-route-id="@property.Id" class="relative h-24 overflow-hidden rounded-2xl bg-brand-50 dark:bg-brand-100/20">
                            @if (!string.IsNullOrWhiteSpace(property.MainImageUrl))
                            {
                                <img src="@property.MainImageUrl" alt="@property.Title" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="flex h-full items-center justify-center text-brand-600"><i data-lucide="building-2" class="h-8 w-8"></i></span>
                            }
                        </a>
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2"><span class="rounded-full bg-success-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wide text-success-700">Disponible</span><span class="font-mono text-xs font-bold text-muted">@property.Code</span></div>
                            <h3 class="mt-2 truncate text-lg font-black text-default">@property.Title</h3>
                            <p class="mt-1 text-sm text-muted">@property.SaleTypeName · @property.Bedrooms hab. · @property.Bathrooms baños · @PriceHelper.FormatArea(property.SizeM2)</p>
                            <p class="mt-2 font-black text-brand-700">@PriceHelper.FormatCompact(property.Price, property.Currency)</p>
                        </div>
                        <div class="flex flex-wrap gap-2 sm:justify-end">
                            <a asp-controller="Offer" asp-action="PropertyOffers" asp-route-propertyId="@property.Id" class="btn-primary">Ofertas</a>
                            <a asp-action="Edit" asp-route-id="@property.Id" class="btn-secondary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@property.Id" class="btn-danger">Eliminar</a>
                        </div>
                    </article>
                }
            </div>
        </section>
        <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(PropertyController.MyProperties), Controller = "Property", CurrentPage = Model.Properties.Page, TotalPages = Model.Properties.TotalPages }' />
    }
</div>
