@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="habita-login-shell w-full max-w-5xl overflow-hidden">
    <section class="habita-login-note hidden lg:flex" aria-label="Acceso a Habita">
        <span class="habita-login-mark"><i data-lucide="house-heart" class="h-7 w-7"></i></span>
        <div>
            <p class="habita-login-kicker">Tu próxima decisión empieza aquí</p>
            <h1>Vuelve a tu espacio.</h1>
            <p class="habita-login-copy">Consulta tus propiedades guardadas, mensajes y avances desde un solo lugar.</p>
        </div>
        <div class="habita-login-tip"><i data-lucide="sparkles" class="h-5 w-5"></i><span>Una búsqueda clara te acerca a sentirte en casa.</span></div>
        <div class="habita-login-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
    </section>

    <section class="habita-login-form surface-elevated">
        <div class="mx-auto w-full max-w-md">
            <div class="mb-8">
                <div class="habita-login-mobile-mark lg:hidden"><i data-lucide="house-heart" class="h-6 w-6"></i><span>Habita</span></div>
                <p class="mb-2 text-xs font-black uppercase tracking-[0.18em] text-brand-600">Acceso a tu cuenta</p>
                <h2 class="text-3xl font-black tracking-tight text-default">Inicia sesión</h2>
                <p class="mt-2 text-sm leading-6 text-muted">Continúa donde dejaste tu búsqueda.</p>
            </div>

            <form asp-action="Login" asp-controller="Auth" method="post" class="space-y-5" data-auth-form>
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                <div class="space-y-1.5">
                    <label asp-for="UserNameOrEmail" class="label-base"></label>
                    <div class="relative"><i data-lucide="at-sign" class="auth-input-icon"></i><input asp-for="UserNameOrEmail" class="input-base auth-input" placeholder="correo@ejemplo.com o usuario" autocomplete="username" autofocus /></div>
                    <span asp-validation-for="UserNameOrEmail" class="field-validation"></span>
                </div>

                <div class="space-y-1.5">
                    <div class="flex items-center justify-between gap-3"><label asp-for="Password" class="label-base mb-0"></label><a asp-action="ForgotPassword" class="text-xs font-bold text-brand-600 hover:underline">¿Olvidaste tu contraseña?</a></div>
                    <div class="relative"><i data-lucide="lock-keyhole" class="auth-input-icon"></i><input asp-for="Password" id="login-password" class="input-base auth-input pr-11" placeholder="Ingresa tu contraseña" autocomplete="current-password" /><button type="button" data-toggle-password="login-password" class="habita-text-control auth-password-toggle" aria-label="Mostrar u ocultar contraseña">Mostrar</button></div>
                    <span asp-validation-for="Password" class="field-validation"></span>
                </div>

                <label class="habita-remember-row"><input asp-for="RememberMe" class="h-4 w-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500" /><span><strong>Mantener sesión iniciada</strong><small>Solo en un dispositivo personal</small></span></label>

                <button type="submit" class="auth-submit btn-primary btn-lg w-full" data-submit-label="Iniciar sesión"><span class="auth-submit-content">Entrar a Habita</span></button>
            </form>

            <div class="mt-7 border-t border-default pt-6 text-center">
                <p class="text-sm text-muted">¿Aún no tienes cuenta? <a asp-action="Register" class="font-bold text-brand-600 hover:underline">Regístrate</a></p>
                <a asp-action="ResendActivation" class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-subtle hover:text-brand-600">Reenviar correo de activación</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
