@model AdminListViewModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var routeValues = new Dictionary<string, object?>();
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) routeValues["searchTerm"] = Model.SearchTerm;
}

<div class="space-y-7">
    <nav class="flex flex-wrap gap-2 border-b border-default pb-3" aria-label="Directorio de usuarios"><a asp-action="Clients" class="rounded-full px-4 py-2 text-sm font-bold text-muted hover:bg-(--color-bg-muted)">Clientes</a><a asp-action="Agents" class="rounded-full px-4 py-2 text-sm font-bold text-muted hover:bg-(--color-bg-muted)">Agentes</a><span class="rounded-full bg-brand-700 px-4 py-2 text-sm font-bold text-white" aria-current="page">Administradores</span><a asp-action="Developers" class="rounded-full px-4 py-2 text-sm font-bold text-muted hover:bg-(--color-bg-muted)">Desarrolladores</a></nav>
    <header class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Directorio / permisos</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Administradores</h1><p class="mt-2 text-sm text-muted">Gestiona las cuentas con acceso administrativo.</p></div><a asp-action="CreateAdmin" class="btn-primary">Crear administrador</a></header>
    <form method="get" asp-action="Admins" class="flex flex-col gap-3 rounded-2xl border border-default bg-(--color-bg-elevated) p-4 sm:flex-row"><label for="admin-search" class="sr-only">Buscar administradores</label><input id="admin-search" type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Nombre, usuario o cédula" class="input-base min-w-0 flex-1" /><button type="submit" class="btn-secondary">Buscar</button>@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Admins" class="btn-ghost text-sm">Limpiar</a>}<span class="self-center text-xs font-bold text-muted">@Model.Items.TotalCount cuentas</span></form>

    @if (Model.Items.Items.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-default p-10 text-center"><p class="text-lg font-black text-default">Sin administradores coincidentes</p><p class="mt-2 text-sm text-muted">Crea la cuenta o ajusta el filtro de búsqueda.</p></div>
    }
    else
    {
        <section class="space-y-3" aria-label="Administradores registrados">
            @foreach (var item in Model.Items.Items)
            {
                <article class="flex flex-col gap-4 rounded-2xl border border-default bg-(--color-bg-elevated) p-5 lg:flex-row lg:items-center">
                    <div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h2 class="text-lg font-black text-default">@item.FullName</h2><span class="rounded-full px-2.5 py-1 text-xs font-bold @(item.IsActive ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-100/10 dark:text-emerald-300" : "bg-amber-100 text-amber-900 dark:bg-amber-100/10 dark:text-amber-300")">@item.StatusLabel</span></div><p class="mt-1 text-sm text-muted">@@@item.UserName <span class="mx-1">·</span> @item.Email</p></div>
                    <div class="grid gap-1 text-xs text-muted sm:grid-cols-2 lg:w-64 lg:grid-cols-1"><span>Documento: <strong class="text-default">@item.IdentityDocument</strong></span><span>Rol: <strong class="text-default">Administrador</strong></span></div>
                    <div class="flex gap-2"><a asp-action="EditAdmin" asp-route-id="@item.Id" class="btn-secondary text-sm">Editar</a><form asp-action="ToggleAdminStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="page" value="@Model.Items.Page" />@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<input type="hidden" name="searchTerm" value="@Model.SearchTerm" />}<button type="submit" class="btn-ghost text-sm">@(item.IsActive ? "Desactivar" : "Activar")</button></form></div>
                </article>
            }
        </section>
        <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(UserController.Admins), Controller = "User", CurrentPage = Model.Items.Page, TotalPages = Model.Items.TotalPages, RouteValues = routeValues }' />
    }
</div>
