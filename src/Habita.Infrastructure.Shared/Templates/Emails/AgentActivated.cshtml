@model Habita.Application.Models.Emails.AgentActivatedModel
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><title>Cuenta habilitada en Habita</title></head>
<body style="font-family:Arial,sans-serif;color:#164e47;background:#f8f6f0;padding:32px">
<h1>Tu cuenta de agente está activa</h1>
<p>Hola, @Model.UserName:</p>
<p>Un administrador ha habilitado tu cuenta en Habita. Ya puedes iniciar sesión con tu usuario y contraseña para publicar y gestionar tus propiedades.</p>
<p>Accede a Habita desde la dirección que utilizaste para registrarte.</p>
<p>Equipo Habita</p>
</body></html>
