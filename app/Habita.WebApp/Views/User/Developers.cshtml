@model DeveloperListViewModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var routeValues = new Dictionary<string, object?>();
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) routeValues["searchTerm"] = Model.SearchTerm;
}

<div class="space-y-7">
    <nav class="flex flex-wrap gap-2 border-b border-default pb-3" aria-label="Directorio de usuarios"><a asp-action="Agents" class="rounded-full px-4 py-2 text-sm font-bold text-muted hover:bg-(--color-bg-muted)">Agentes</a><a asp-action="Admins" class="rounded-full px-4 py-2 text-sm font-bold text-muted hover:bg-(--color-bg-muted)">Administradores</a><span class="rounded-full bg-brand-700 px-4 py-2 text-sm font-bold text-white" aria-current="page">Desarrolladores</span></nav>
    <header class="grid gap-5 rounded-3xl bg-brand-700 p-6 text-white sm:grid-cols-[1fr_auto] sm:items-end sm:p-8 dark:bg-[#10594f]"><div><p class="text-xs font-black uppercase tracking-[.16em] text-white/80">Directorio / equipo técnico</p><h1 class="mt-2 text-3xl font-black tracking-tight">Desarrolladores</h1><p class="mt-2 max-w-xl text-sm leading-6 text-white/85">Cuentas del equipo con acceso de desarrollo a la API y al entorno de trabajo.</p></div><a asp-action="CreateDeveloper" class="btn-secondary border-white/30 bg-white text-brand-700 hover:bg-brand-50">Añadir desarrollador</a></header>
    <form method="get" asp-action="Developers" class="flex flex-col gap-3 sm:flex-row sm:items-center"><label for="developer-search" class="text-sm font-bold text-default">Buscar cuenta</label><input id="developer-search" type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Nombre, usuario o documento" class="input-base min-w-0 flex-1" /><button type="submit" class="btn-secondary">Buscar</button>@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Developers" class="btn-ghost text-sm">Limpiar</a>}</form>

    @if (Model.Items.Items.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-default p-10 text-center"><p class="text-lg font-black text-default">No hay desarrolladores para mostrar</p><p class="mt-2 text-sm text-muted">Agrega una cuenta o prueba otro criterio.</p></div>
    }
    else
    {
        <section class="grid gap-3" aria-label="Desarrolladores registrados">
            @foreach (var item in Model.Items.Items)
            {
                <article class="grid gap-4 rounded-2xl border border-default bg-(--color-bg-elevated) p-5 md:grid-cols-3 md:items-center">
                    <div><div class="flex flex-wrap items-center gap-2"><h2 class="text-lg font-black text-default">@item.FullName</h2><span class="rounded-full px-2.5 py-1 text-xs font-bold @(item.IsActive ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-100/10 dark:text-emerald-300" : "bg-amber-100 text-amber-900 dark:bg-amber-100/10 dark:text-amber-300")">@item.StatusLabel</span></div><p class="mt-1 text-sm text-muted">@@@item.UserName <span class="mx-1">·</span> @item.Email</p></div>
                    <div class="border-l-2 border-sky-400 pl-3"><p class="text-xs font-bold uppercase tracking-wide text-muted">Identificador</p><p class="mt-1 font-mono text-sm font-bold text-default">@item.IdentityDocument</p></div>
                    <div class="flex gap-2"><a asp-action="EditDeveloper" asp-route-id="@item.Id" class="btn-secondary text-sm">Editar</a><form asp-action="ToggleDeveloperStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="page" value="@Model.Items.Page" />@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<input type="hidden" name="searchTerm" value="@Model.SearchTerm" />}<button type="submit" class="btn-ghost text-sm">@(item.IsActive ? "Desactivar" : "Activar")</button></form></div>
                </article>
            }
        </section>
        <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(UserController.Developers), Controller = "User", CurrentPage = Model.Items.Page, TotalPages = Model.Items.TotalPages, RouteValues = routeValues }' />
    }
</div>
