@model AgentHomeViewModel
@{
    ViewData["Title"] = "Panel de agente";
}

<div class="habita-page space-y-8">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700" role="alert"></div>
    }

    <section class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]" aria-label="Resumen de actividad">
        <aside class="flex flex-col justify-between rounded-3xl bg-brand-700 p-6 text-white dark:bg-[#10594f]">
            <div>
                <p class="text-xs font-black uppercase tracking-[.16em] text-white/75">Área profesional</p>
                <h1 class="mt-3 text-3xl font-black tracking-tight">Panel del agente</h1>
                <p class="mt-3 text-sm leading-6 text-white/80">Tu actividad inmobiliaria, organizada desde un solo lugar.</p>
            </div>
            <a asp-controller="Property" asp-action="Create" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-2xl bg-white px-5 text-sm font-black text-brand-700 transition hover:bg-brand-50">Publicar propiedad</a>
        </aside>

        <div class="grid gap-4 sm:grid-cols-3">
            <article class="flex min-h-40 flex-col justify-between rounded-3xl border border-default bg-(--color-bg-elevated) p-5">
                <p class="text-xs font-black uppercase tracking-wider text-muted">Gestionadas</p>
                <p class="text-5xl font-black tracking-tight text-default">@Model.TotalProperties</p>
                <p class="text-sm text-muted">Propiedades en tu inventario</p>
            </article>
            <article class="flex min-h-40 flex-col justify-between rounded-3xl bg-brand-50 p-5 dark:bg-brand-100/10">
                <p class="text-xs font-black uppercase tracking-wider text-brand-700 dark:text-brand-400">Disponibles</p>
                <p class="text-5xl font-black tracking-tight text-brand-700 dark:text-brand-400">@Model.AvailablePropertiesCount</p>
                <a asp-controller="Property" asp-action="MyProperties" class="text-sm font-bold text-brand-700 underline-offset-4 hover:underline dark:text-brand-400">Abrir inventario</a>
            </article>
            <article class="flex min-h-40 flex-col justify-between rounded-3xl border border-default bg-(--color-bg-elevated) p-5">
                <p class="text-xs font-black uppercase tracking-wider text-muted">Vendidas</p>
                <p class="text-5xl font-black tracking-tight text-default">@Model.SoldPropertiesCount</p>
                <p class="text-sm text-muted">Operaciones cerradas</p>
            </article>
        </div>
    </section>

    <section class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_17rem]" aria-labelledby="market-title">
        <div>
            <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
                <div><p class="text-xs font-black uppercase tracking-[.14em] text-brand-600">En mercado</p><h2 id="market-title" class="mt-1 text-2xl font-black text-default">Disponibles para negociación</h2></div>
                <a asp-controller="Property" asp-action="MyProperties" class="btn-secondary">Ver todas</a>
            </div>
            @if (Model.AvailableProperties.Count == 0)
            {
                <div class="rounded-3xl border border-dashed border-default bg-(--color-bg-elevated)">
                    <partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("building-2", "No tienes propiedades disponibles", "Publica tu primer inmueble para comenzar a captar interesados.", "<a href=\"/Property/Create\" class=\"btn-primary\">Publicar propiedad</a>")' />
                </div>
            }
            else
            {
                <div class="space-y-4" role="list" aria-label="Propiedades disponibles">
                    @foreach (var property in Model.AvailableProperties)
                    {
                        <article class="grid overflow-hidden rounded-3xl border border-default bg-(--color-bg-elevated) sm:grid-cols-[12rem_minmax(0,1fr)]" role="listitem">
                            <a asp-controller="Property" asp-action="Detail" asp-route-id="@property.Id" class="relative min-h-40 bg-brand-50 dark:bg-brand-100/20">
                                @if (!string.IsNullOrWhiteSpace(property.MainImageUrl))
                                {
                                    <img src="@property.MainImageUrl" alt="@property.Title" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="flex h-full min-h-40 items-center justify-center bg-linear-to-br from-brand-from to-brand-to text-white/70"><i data-lucide="building-2" class="h-10 w-10"></i></span>
                                }
                            </a>
                            <div class="flex flex-col justify-between gap-4 p-5 sm:flex-row sm:items-center">
                                <div class="min-w-0"><p class="text-xs font-black uppercase tracking-wider text-brand-600">@property.SaleTypeName · REF. @property.Code</p><h3 class="mt-1 text-lg font-black text-default">@property.Title</h3><p class="mt-2 text-sm font-bold text-muted">@PriceHelper.FormatCompact(property.Price, property.Currency)</p></div>
                                <div class="flex flex-wrap gap-2"><a asp-controller="Offer" asp-action="PropertyOffers" asp-route-propertyId="@property.Id" class="btn-primary">Ofertas</a><a asp-controller="Property" asp-action="Edit" asp-route-id="@property.Id" class="btn-secondary">Editar</a></div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <aside class="h-fit rounded-3xl border border-default bg-(--color-bg-elevated) p-5">
            <p class="text-xs font-black uppercase tracking-[.14em] text-muted">Accesos</p>
            <h2 class="mt-2 text-lg font-black text-default">Gestión diaria</h2>
            <nav class="mt-4 divide-y divide-default" aria-label="Accesos del agente">
                <a asp-controller="Property" asp-action="Create" class="flex justify-between py-3 text-sm font-bold text-brand-700 hover:text-brand-600">Crear publicación <span aria-hidden="true">→</span></a>
                <a asp-controller="Property" asp-action="MyProperties" class="flex justify-between py-3 text-sm font-bold text-brand-700 hover:text-brand-600">Mis propiedades <span aria-hidden="true">→</span></a>
                <a asp-controller="Message" asp-action="Index" class="flex justify-between py-3 text-sm font-bold text-brand-700 hover:text-brand-600">Bandeja de mensajes <span aria-hidden="true">→</span></a>
                <a asp-action="Profile" class="flex justify-between py-3 text-sm font-bold text-brand-700 hover:text-brand-600">Mi perfil <span aria-hidden="true">→</span></a>
            </nav>
        </aside>
    </section>

    @if (Model.SoldProperties.Count > 0)
    {
        <section class="border-t border-default pt-7" aria-labelledby="closed-title">
            <div class="mb-4"><p class="text-xs font-black uppercase tracking-[.14em] text-muted">Historial</p><h2 id="closed-title" class="mt-1 text-xl font-black text-default">Operaciones cerradas</h2></div>
            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" role="list">
                @foreach (var property in Model.SoldProperties)
                {
                    <a asp-controller="Property" asp-action="Detail" asp-route-id="@property.Id" class="flex items-center justify-between gap-4 rounded-2xl border border-default bg-(--color-bg-elevated) p-4 hover:border-brand-500" role="listitem">
                        <span class="min-w-0"><span class="block truncate font-bold text-default">@property.Title</span><span class="mt-1 block text-sm text-muted">Vendida · @property.Code</span></span><span class="shrink-0 font-black text-brand-700">@PriceHelper.FormatCompact(property.Price, property.Currency)</span>
                    </a>
                }
            </div>
        </section>
    }
</div>
