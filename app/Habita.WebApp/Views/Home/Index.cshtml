@model HomeIndexViewModel
@{
    ViewData["Title"] = "Explora propiedades";
    var paginationValues = Model.Filters.RouteValues();
}

<div class="space-y-10">
    <section
        class="habita-hero relative overflow-hidden rounded-[2rem] border border-brand-100 px-5 py-12 text-white shadow-xl sm:px-10 sm:py-16">
        <div class="pointer-events-none absolute -right-24 -top-28 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-sky-300/20 blur-3xl">
        </div>
        <div class="relative mx-auto max-w-3xl text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-bold backdrop-blur"><i
                data-lucide="badge-check" class="h-4 w-4"></i>Una búsqueda más tranquila empieza aquí</span>
                <h1 class="mt-6 text-4xl font-black leading-[1.05] tracking-tight sm:text-5xl">Encuentra el espacio<br
                    class="hidden sm:block" /> que se siente como tuyo.</h1>
                    <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-emerald-50 sm:text-base">Explora hogares seleccionados, compara con calma y conversa directamente con profesionales activos.</p>

                        <form asp-action="Index" method="get"
                              class="mx-auto mt-8 flex max-w-2xl flex-col gap-3 rounded-2xl border border-white/20 bg-white/10 p-3 shadow-lg backdrop-blur-md sm:flex-row"
                              data-home-search>
                            <label for="property-code" class="sr-only">Código de propiedad</label>
                            <div class="relative min-w-0 flex-1">
                                <i data-lucide="scan-search"
                                   class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-emerald-100"></i>
                                <input id="property-code" name="Code" value="@Model.Filters.Code" type="text" inputmode="numeric"
                                       pattern="[0-9]{6}" maxlength="6"
                                       class="h-12 w-full rounded-xl border border-white/10 bg-white px-11 text-sm font-semibold text-slate-900 outline-none ring-0 transition placeholder:text-slate-400 focus:ring-4 focus:ring-white/30"
                                       placeholder="Busca por código de 6 dígitos" aria-describedby="code-help" />
                            </div>
                            <button type="submit" class="btn-primary min-h-12 bg-slate-950 px-6 shadow-none hover:bg-slate-800"
                                    data-home-search-submit>Buscar</button>
                        </form>
                        <p id="code-help" class="mt-3 text-xs font-medium text-emerald-50">Ejemplo: 123456. Deja campo vacío para
                            explorar todas.</p>
                        </div>
                    </section>

                    <section aria-labelledby="properties-title">
                        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                            <div>
                                <p class="text-xs font-black uppercase tracking-[0.16em] text-brand-600 dark:text-brand-500">Catálogo
                                    inmobiliario</p>
                                    <h2 id="properties-title" class="mt-1 text-2xl font-black tracking-tight text-default sm:text-3xl">
                                        Espacios disponibles</h2>
                                        <p class="mt-1 text-sm text-muted" aria-live="polite">@Model.Properties.TotalCount
                                            @(Model.Properties.TotalCount == 1 ? "resultado" : "resultados") encontrados</p>
                                        </div>
                                        <details class="relative lg:hidden">
                                            <summary class="btn-secondary cursor-pointer list-none">Filtros
@if (Model.HasActiveFilters) { <span
                                                class="badge-info">Activos</span> }</summary>
                                                <div
                                                    class="absolute right-0 z-30 mt-3 w-[min(23rem,calc(100vw-2rem))] rounded-2xl border border-default bg-(--color-bg-elevated) p-5 shadow-xl">
                                                    <partial name="~/Views/Home/_PropertyFilters.cshtml" model="Model.Filters" />
                                                </div>
                                            </details>
                                        </div>

                                        @if (!ViewData.ModelState.IsValid)
                                        {
                                            <div asp-validation-summary="All"
                                                 class="mb-6 rounded-2xl border border-danger-500/30 bg-danger-50 px-4 py-3 text-sm font-medium text-danger-700 dark:bg-danger-50">
                                            </div>
                                        }

                                        <div class="grid gap-8 lg:grid-cols-[20rem_minmax(0,1fr)]">
                                            <aside
                                                class="hidden self-start rounded-2xl border border-default bg-(--color-bg-elevated) p-5 shadow-sm lg:block lg:sticky lg:top-20"
                                                aria-label="Filtros de propiedades">
                                                <div class="mb-5 flex items-center gap-2"><span
                                                    class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-100/20 dark:text-brand-500"><i
                                                    data-lucide="sliders-horizontal" class="h-4 w-4"></i></span>
                                                    <div>
                                                        <h3 class="text-sm font-black text-default">Encuentra tu próximo lugar</h3>
                                                        <p class="text-xs text-subtle">Combina los criterios que importan</p>
                                                    </div>
                                                </div>
                                                <partial name="~/Views/Home/_PropertyFilters.cshtml" model="Model.Filters" />
                                            </aside>

                                            <div>
                                                @if (Model.Properties.Items.Count == 0)
                                                {
                                                    var emptyTitle = !string.IsNullOrWhiteSpace(Model.Filters.Code) ? "No encontramos esa propiedad" : "No hay coincidencias";
                                                    var emptyText = !string.IsNullOrWhiteSpace(Model.Filters.Code) ? "No se encontró ninguna propiedad disponible con el código ingresado." : "Prueba ajustando tus filtros para descubrir más opciones.";
                                                    var action = "<a href='/' class='btn-primary'>Limpiar búsqueda</a>";
                                                    var emptyState = ("search-x", emptyTitle, emptyText, action);
                                                    <partial name="~/Views/Shared/Components/_EmptyState.cshtml" model="emptyState" />
                                                }
                                                else
                                                {
                                                    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3" role="list" aria-label="Espacios disponibles">
                                                        @foreach (var property in Model.Properties.Items)
                                                        {
                                                            <div role="listitem">
                                                                <partial name="~/Views/Home/_PropertyCard.cshtml" model="property" />
                                                            </div>
                                                        }
                                                    </div>
                                                    <partial name="~/Views/Home/_Pagination.cshtml"
                                                             model="new PaginationViewModel { Action = nameof(HomeController.Index), CurrentPage = Model.Properties.Page, TotalPages = Model.Properties.TotalPages, RouteValues = paginationValues }" />
                                                }
                                            </div>
                                        </div>
                                    </section>
                                </div>

                                @section Scripts {
                                    <script src="~/js/home.js" asp-append-version="true"></script>
                                }
