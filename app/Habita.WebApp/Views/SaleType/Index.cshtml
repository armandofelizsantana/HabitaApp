@model SaleTypeListViewModel
@{
    ViewData["Title"] = "Tipos de venta";
    var routeValues = new Dictionary<string, object?>();
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) routeValues["searchTerm"] = Model.SearchTerm;
}

<div class="space-y-7">
    <header class="rounded-3xl border border-default bg-(--color-bg-elevated) p-6 sm:p-8">
        <div class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Catálogo / operación</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Modalidades de venta</h1><p class="mt-2 max-w-xl text-sm leading-6 text-muted">Define cómo se ofrece cada propiedad: venta, alquiler u otras condiciones.</p></div><a asp-action="Create" class="btn-primary">Añadir modalidad</a></div>
        <div class="mt-7 grid gap-3 sm:grid-cols-3" aria-label="Total de modalidades registradas"><div class="border-l-4 border-brand-500 pl-4"><p class="text-2xl font-black text-default">@Model.Items.TotalCount</p><p class="text-xs font-bold uppercase tracking-wide text-muted">Modalidades</p></div><div class="border-l-4 border-emerald-500 pl-4"><p class="text-sm font-black text-default">Códigos únicos</p><p class="text-xs text-muted">Cada modalidad tiene una clave.</p></div><div class="border-l-4 border-amber-500 pl-4"><p class="text-sm font-black text-default">Reutilizables</p><p class="text-xs text-muted">Se seleccionan al publicar propiedades.</p></div></div>
    </header>

    <form method="get" asp-action="Index" class="flex flex-col gap-3 rounded-2xl border border-default bg-(--color-bg-elevated) p-4 sm:flex-row sm:items-center">
        <label for="sale-search" class="shrink-0 text-sm font-bold text-default">Filtrar modalidades</label><input id="sale-search" type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Nombre o descripción" class="input-base min-w-0 flex-1" /><button type="submit" class="btn-secondary">Buscar</button>@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Index" class="btn-ghost text-sm">Limpiar</a>}
    </form>

    @if (Model.Items.Items.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-default bg-(--color-bg-elevated) p-6"><partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("receipt", "Sin modalidades", "No hay tipos de venta que coincidan con la búsqueda.", "<a href=\"/SaleType/Create\" class=\"btn-primary\">Añadir modalidad</a>")' /></div>
    }
    else
    {
        <section class="space-y-3" aria-label="Modalidades registradas">
            @foreach (var item in Model.Items.Items)
            {
                var codeStyle = item.Code switch { "Sale" => "border-emerald-300 bg-emerald-50 text-emerald-800 dark:bg-emerald-100/10 dark:text-emerald-300", "Rent" => "border-sky-300 bg-sky-50 text-sky-800 dark:bg-sky-100/10 dark:text-sky-300", "RentToOwn" => "border-amber-300 bg-amber-50 text-amber-800 dark:bg-amber-100/10 dark:text-amber-300", _ => "border-default bg-(--color-bg-muted) text-default" };
                var codeLabel = item.Code switch { "Sale" => "Venta", "Rent" => "Alquiler", "RentToOwn" => "Traspaso", _ => item.Code };
                <article class="grid gap-4 rounded-2xl border border-default bg-(--color-bg-elevated) p-5 sm:grid-cols-4 sm:items-center">
                    <div class="rounded-xl border px-3 py-3 text-center @codeStyle"><p class="text-[10px] font-black uppercase tracking-[.12em]">Código</p><p class="mt-1 break-words text-sm font-black">@codeLabel</p></div>
                    <div><h2 class="text-lg font-black text-default">@item.Name</h2><p class="mt-1 text-sm leading-5 text-muted">@item.Description</p></div>
                    <div class="sm:border-l sm:border-default sm:pl-5"><p class="text-2xl font-black text-default">@item.PropertiesCount</p><p class="text-xs font-bold uppercase tracking-wide text-muted">propiedades</p></div>
                    <div class="flex gap-2 sm:justify-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary px-3 py-2 text-sm">Editar</a><form asp-action="Delete" method="post" data-confirm="¿Eliminar &quot;@item.Name&quot;?" data-confirm-text="Se eliminarán las propiedades asociadas (@item.PropertiesCount), sus imágenes, ofertas, mensajes y favoritos. Esta acción es permanente.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="page" value="@Model.Items.Page" />@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<input type="hidden" name="searchTerm" value="@Model.SearchTerm" />}<button type="submit" class="btn-ghost px-3 py-2 text-sm text-danger-600">Eliminar</button></form></div>
                </article>
            }
        </section>
        <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(SaleTypeController.Index), Controller = "SaleType", CurrentPage = Model.Items.Page, TotalPages = Model.Items.TotalPages, RouteValues = routeValues }' />
    }
</div>
