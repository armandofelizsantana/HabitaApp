@model CreatePropertyViewModel
@{
    ViewData["Title"] = "Publicar propiedad";
    var canCreate = Model.PropertyTypes.Count > 0 && Model.SaleTypes.Count > 0 && Model.Improvements.Count > 0;
}

<div class="habita-page mx-auto max-w-6xl space-y-7">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-default pb-4">
        <nav aria-label="Ruta de navegación"><ol class="flex flex-wrap items-center gap-2 text-sm text-muted"><li><a asp-action="MyProperties" class="font-semibold hover:text-brand-600">Mis propiedades</a></li><li aria-hidden="true">/</li><li class="font-bold text-default" aria-current="page">Nueva publicación</li></ol></nav>
        <span class="text-xs font-bold uppercase tracking-wider text-muted">Alta de inmueble</span>
    </div>

    <header class="grid gap-6 rounded-3xl bg-brand-700 p-6 text-white sm:grid-cols-[minmax(0,1fr)_16rem] sm:items-center sm:p-8 dark:bg-[#10594f]">
        <div><p class="text-xs font-black uppercase tracking-[.16em] text-white/75">Publicar</p><h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">Presenta una nueva propiedad</h1><p class="mt-3 max-w-2xl text-sm leading-6 text-white/85">Completa la información y agrega imágenes para que el inmueble esté listo para aparecer en el catálogo.</p></div>
        <div class="rounded-2xl border border-white/20 bg-white/10 p-4"><p class="text-xs font-black uppercase tracking-wider text-white/75">Al publicar</p><p class="mt-2 text-sm font-bold">Se asigna un código único y el estado inicial será Disponible.</p></div>
    </header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700" role="alert"></div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6" data-property-form novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Currency" type="hidden" value="DOP" />

        <section class="rounded-3xl border border-default bg-(--color-bg-elevated) p-5 shadow-sm sm:p-7" aria-labelledby="property-info-title">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3 border-b border-default pb-4"><div><p class="text-xs font-black uppercase tracking-wider text-brand-600">01 / Información</p><h2 id="property-info-title" class="mt-1 text-xl font-black text-default">Datos del inmueble</h2></div><span class="text-xs font-semibold text-muted">Los campos requeridos se indican en el formulario.</span></div>
            <partial name="_PropertyFormFields" model="Model" />
        </section>

        <section class="rounded-3xl border border-default bg-(--color-bg-elevated) p-5 shadow-sm sm:p-7" aria-labelledby="property-images-title">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3 border-b border-default pb-4"><div><p class="text-xs font-black uppercase tracking-wider text-brand-600">02 / Imágenes</p><h2 id="property-images-title" class="mt-1 text-xl font-black text-default">Galería del inmueble</h2></div><p class="max-w-lg text-sm text-muted">Carga entre 1 y 4 imágenes JPG, PNG o WebP, máximo 15 MB cada una.</p></div>
            <div data-image-uploader data-existing-count="0" data-input-name="imageFiles">
                <label class="flex min-h-44 cursor-pointer flex-col items-center justify-center rounded-3xl border-2 border-dashed border-default bg-(--color-bg-muted) px-5 text-center transition hover:border-brand-500 hover:bg-brand-50/60 dark:hover:bg-brand-100/10" data-drop-zone tabindex="0">
                    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-brand-600 shadow-sm dark:bg-gray-800"><i data-lucide="image-up" class="h-6 w-6"></i></span><span class="mt-4 text-sm font-black text-default">Arrastra imágenes o selecciónalas</span><span class="mt-1 text-xs text-muted">La primera imagen será la portada de la publicación.</span>
                    <input type="file" name="imageFiles" accept="image/jpeg,image/png,image/webp" multiple required class="sr-only" data-image-input />
                </label>
                <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4" data-image-previews aria-live="polite"></div>
                <div class="mt-3 flex items-center justify-between gap-3"><span class="text-xs font-semibold text-muted" data-image-status>0 de 4 imágenes</span><span class="text-xs font-semibold text-danger-700" data-image-error role="alert"></span></div>
                @Html.ValidationMessage("imageFiles", null, new { @class = "mt-1 block text-xs font-semibold text-danger-700" })
            </div>
        </section>

        <footer class="flex flex-col gap-4 rounded-3xl border border-brand-100 bg-brand-50 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6 dark:border-brand-100/20 dark:bg-brand-100/10">
            <div><p class="text-xs font-black uppercase tracking-wider text-brand-700 dark:text-brand-400">Resumen de publicación</p><p class="mt-1 text-2xl font-black text-default" data-price-preview>RD$ 0.00</p><p class="mt-1 text-sm text-muted">Estado: Disponible · Código inmobiliario generado al publicar</p></div>
            <div class="flex flex-col-reverse gap-3 sm:flex-row"><a asp-action="MyProperties" class="btn-secondary">Cancelar</a><button type="submit" class="btn-primary" disabled="@(!canCreate)">Crear propiedad</button></div>
        </footer>
    </form>
</div>

@section Scripts { <script src="~/js/property-form.js" asp-append-version="true"></script> }
