@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="mx-auto max-w-5xl">
    <header class="mb-8 border-b border-default pb-5"><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Cuenta / seguridad</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Cambiar contraseña</h1><p class="mt-2 text-sm text-muted">Actualiza tus credenciales para proteger el acceso a Habita.</p></header>
    <div class="grid gap-6 lg:grid-cols-[.8fr_1.2fr]">
        <aside class="flex flex-col justify-between rounded-3xl bg-brand-700 p-6 text-white sm:p-8 dark:bg-[#10594f]">
            <div><p class="text-xs font-black uppercase tracking-[.15em] text-brand-200">Antes de guardar</p><h2 class="mt-3 text-2xl font-black">Una contraseña nueva, solo tuya.</h2><p class="mt-3 text-sm leading-6 text-white/70">Usa una clave que no compartas con otros servicios y confirma que puedes recordarla.</p></div>
            <ol class="mt-8 space-y-4">
                <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/15 text-xs font-black">1</span><span class="pt-1 text-sm font-semibold">Verifica tu contraseña actual.</span></li>
                <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/15 text-xs font-black">2</span><span class="pt-1 text-sm font-semibold">Escribe una contraseña nueva de al menos ocho caracteres.</span></li>
                <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/15 text-xs font-black">3</span><span class="pt-1 text-sm font-semibold">Confírmala para evitar errores de escritura.</span></li>
            </ol>
        </aside>
        <form asp-action="ChangePassword" method="post" class="rounded-3xl border border-default bg-(--color-bg-elevated) p-6 shadow-sm sm:p-8" data-auth-form>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="mb-5 validation-summary" role="alert"></div>
            <div class="space-y-5">
                <div class="space-y-1.5"><label asp-for="CurrentPassword" class="label-base"></label><input asp-for="CurrentPassword" class="input-base" autocomplete="current-password" autofocus /><span asp-validation-for="CurrentPassword" class="field-validation"></span></div>
                <div class="space-y-1.5"><label asp-for="NewPassword" class="label-base"></label><input asp-for="NewPassword" class="input-base" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="field-validation"></span></div>
                <div class="space-y-1.5"><label asp-for="ConfirmPassword" class="label-base"></label><input asp-for="ConfirmPassword" class="input-base" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div>
            </div>
            <div class="mt-8 flex flex-col-reverse gap-3 border-t border-default pt-6 sm:flex-row sm:justify-end"><a asp-controller="Home" asp-action="Index" class="btn-secondary">Cancelar</a><button type="submit" class="btn-primary">Guardar contraseña</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
