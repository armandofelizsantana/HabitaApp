@model PropertyFilterViewModel
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var agentId = ViewData["AgentFilterId"] as string;
}

<form asp-action="@action" asp-route-id="@agentId" method="get" class="space-y-5" aria-label="Filtros de propiedades">
    @if (agentId is not null && ViewContext.RouteData.Values["id"] is null)
    {
        <input type="hidden" name="id" value="@agentId" />
    }
    @if (ViewData["ShowFilterCode"] is true)
    {
        <label class="label-base">Código de propiedad
            <input name="Code" value="@Model.Code" class="input-base" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="6 dígitos" />
        </label>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Code))
    {
        <input type="hidden" name="Code" value="@Model.Code" />
    }
    <div>
        <label for="property-type" class="label-base">Tipo de propiedad</label>
        <select id="property-type" name="PropertyTypeId" class="select-base">
            <option value="">Todos los tipos</option>
            @foreach (var type in Model.PropertyTypes)
            {
                <option value="@type.Id" selected="@(type.Id == Model.PropertyTypeId)">@type.Name</option>
            }
        </select>
    </div>

    <div class="grid grid-cols-2 gap-3">
        <div>
            <label for="price-min" class="label-base">Precio mínimo</label>
            <input id="price-min" name="PriceMin" value="@Model.PriceMin" type="number" min="0" step="0.01"
                   inputmode="decimal" class="input-base" placeholder="RD$ 0" />
        </div>
        <div>
            <label for="price-max" class="label-base">Precio máximo</label>
            <input id="price-max" name="PriceMax" value="@Model.PriceMax" type="number" min="0" step="0.01"
                   inputmode="decimal" class="input-base" placeholder="Sin límite" />
        </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
        <div>
            <label for="bedrooms" class="label-base">Habitaciones</label>
            <input id="bedrooms" name="Bedrooms" value="@Model.Bedrooms" type="number" min="0" max="100"
                   inputmode="numeric" class="input-base" placeholder="Cualquiera" />
        </div>
        <div>
            <label for="bathrooms" class="label-base">Baños</label>
            <input id="bathrooms" name="Bathrooms" value="@Model.Bathrooms" type="number" min="0" max="100"
                   inputmode="numeric" class="input-base" placeholder="Cualquiera" />
        </div>
    </div>

    <div class="flex gap-3 border-t border-default pt-5">
        <button type="submit" class="btn-primary flex-1">Aplicar</button>
        <a asp-action="@action" asp-route-id="@agentId" class="btn-secondary">Limpiar</a>
    </div>
</form>
