@model ImprovementListViewModel
@{
    ViewData["Title"] = "Características";
    var routeValues = new Dictionary<string, object?>();
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) routeValues["searchTerm"] = Model.SearchTerm;
}

<div class="space-y-7">
    <header class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
        <div><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Biblioteca de atributos</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Características</h1><p class="mt-2 max-w-2xl text-sm leading-6 text-muted">Administra los detalles que ayudan a describir y comparar cada propiedad.</p></div>
        <div class="flex items-center gap-3"><div class="rounded-xl border border-default bg-(--color-bg-elevated) px-4 py-2"><p class="text-xl font-black text-default">@Model.Items.TotalCount</p><p class="text-[10px] font-bold uppercase tracking-wide text-muted">registradas</p></div><a asp-action="Create" class="btn-primary">Nueva característica</a></div>
    </header>

    <div class="grid gap-6 xl:grid-cols-[15rem_minmax(0,1fr)]">
        <aside class="h-fit rounded-2xl border border-default bg-(--color-bg-elevated) p-5">
            <p class="text-xs font-black uppercase tracking-[.13em] text-muted">Buscar en biblioteca</p><p class="mt-2 text-sm leading-5 text-muted">Usa un término del nombre o de la descripción.</p>
            <form method="get" asp-action="Index" class="mt-4 space-y-3"><label for="improvement-search" class="sr-only">Buscar características</label><input id="improvement-search" type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Ej. terraza" class="input-base w-full" /><button type="submit" class="btn-secondary w-full">Buscar</button>@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Index" class="block text-center text-sm font-bold text-brand-700 dark:text-brand-400">Mostrar todo</a>}</form>
            <div class="mt-6 border-t border-default pt-4"><p class="text-xs font-bold uppercase tracking-wide text-muted">Uso</p><p class="mt-2 text-sm text-default">Los recuentos indican en cuántas propiedades aparece cada característica.</p></div>
        </aside>
        <section aria-label="Características registradas">
            @if (Model.Items.Items.Count == 0)
            {
                <div class="rounded-3xl border border-dashed border-default bg-(--color-bg-elevated) p-6"><partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("sparkles", "No hay características", "Agrega la primera característica o cambia la búsqueda.", "<a href=\"/Improvement/Create\" class=\"btn-primary\">Crear característica</a>")' /></div>
            }
            else
            {
                <div class="grid gap-3 md:grid-cols-2">
                    @foreach (var item in Model.Items.Items)
                    {
                        <article class="flex min-h-40 flex-col justify-between rounded-2xl border border-default bg-(--color-bg-elevated) p-5 transition hover:-translate-y-0.5 hover:shadow-md">
                            <div class="flex items-start justify-between gap-3"><span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black text-amber-900 dark:bg-amber-100/10 dark:text-amber-300">@(item.PropertiesCount == 0 ? "Sin asignar" : "En catálogo")</span><span class="text-xs font-bold text-muted">@item.PropertiesCount uso@(item.PropertiesCount == 1 ? "" : "s")</span></div>
                            <div class="mt-5"><h2 class="text-lg font-black text-default">@item.Name</h2><p class="mt-1 text-sm leading-5 text-muted">@item.Description</p></div>
                            <div class="mt-5 flex justify-end gap-2 border-t border-default pt-3"><a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary px-3 py-2 text-sm">Editar</a><form asp-action="Delete" method="post" data-confirm="¿Eliminar &quot;@item.Name&quot;?" data-confirm-text="Se quitará de las propiedades asociadas.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="page" value="@Model.Items.Page" />@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)){<input type="hidden" name="searchTerm" value="@Model.SearchTerm" />}<button type="submit" class="btn-ghost px-3 py-2 text-sm text-danger-600">Eliminar</button></form></div>
                        </article>
                    }
                </div>
                <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(ImprovementController.Index), Controller = "Improvement", CurrentPage = Model.Items.Page, TotalPages = Model.Items.TotalPages, RouteValues = routeValues }' />
            }
        </section>
    </div>
</div>
